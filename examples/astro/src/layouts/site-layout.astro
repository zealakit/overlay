---
import "../styles/styles.css";
import "../styles/popover-examples.css";
import "../styles/tooltip-examples.css";
import "../styles/dialog-examples.css";
import "../styles/context-menu-examples.css";
import "../styles/arrow-animation-examples.css";

type Props = { title: string };
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
